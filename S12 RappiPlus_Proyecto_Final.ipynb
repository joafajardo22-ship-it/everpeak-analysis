    "\n",
    "# Diferencia entre monto registrado y calculado\n",
    "orders_clean[\"diferencia_monto%\"] = (\n",
    "    orders_clean[\"monto_total\"] -\n",
    "    orders_clean[\"monto_total_calculado\"]\n",
    ") / orders_clean[\"monto_total_calculado\"]\n",
    "\n",
    "# Detectar inconsistencias\n",
    "\n",
    "inconsistencias_monto = (\n",
    "    orders_clean[\"diferencia_monto%\"] >= 0.01\n",
    ")\n",
    "\n",
    "print(\"\\nRegistros con montos inconsistentes:\",\n",
