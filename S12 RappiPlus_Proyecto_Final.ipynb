   "source": [
    "# PARTE 1: Totales del funnel\n",
    "# ======================\n",
    "\n",
    "query_totals = '''\n",
    "SELECT\n",
    "    nombre_evento,\n",
    "    COUNT(DISTINCT id_usuario) AS usuarios\n",
    "FROM events\n",
    "WHERE nombre_evento IN (\n",
    "    'first_visit',\n",
    "    'add_to_cart',\n",
    "    'add_payment_info',\n",
    "    'purchase'\n",
    ")\n",
    "GROUP BY nombre_evento\n",
    "ORDER BY\n",
    "    CASE nombre_evento\n",
    "        WHEN 'first_visit' THEN 1\n",
    "        WHEN 'add_to_cart' THEN 2\n",
