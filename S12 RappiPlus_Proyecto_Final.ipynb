    "# nulos por %\n",
    "def resumen_nulos(df, nombre):\n",
    "    resultado = pd.DataFrame({\n",
    "        \"nulos\": df.isnull().sum(),\n",
    "        \"porcentaje_nulos\": (df.isnull().mean() * 100).round(2)\n",
    "    })\n",
    "    \n",
    "    print(f\"\\n========== {nombre.upper()} ==========\")\n",
    "    display(resultado[resultado[\"nulos\"] > 0])\n",
    "\n",
    "resumen_nulos(orders, \"orders\")\n",
    "resumen_nulos(catalog, \"catalog\")\n",
    "resumen_nulos(marketing, \"marketing\")"
   ]
