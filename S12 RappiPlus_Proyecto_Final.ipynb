   "source": [
    "# Retención por cohortes\n",
    "# ======================\n",
    "\n",
    "query_cohort_retention_final = '''\n",
    "WITH usuarios_cohorte AS (\n",
    "    SELECT\n",
    "        id_usuario,\n",
    "        CAST(fecha_registro AS DATE) AS fecha_registro,\n",
    "        DATE_TRUNC(\n",
    "            'month',\n",
    "            CAST(fecha_registro AS DATE)\n",
    "        ) AS cohorte\n",
    "    FROM users\n",
    "),\n",
    "\n",
    "usuarios_iniciales AS (\n",
    "    SELECT\n",
    "        cohorte,\n",
    "        COUNT(DISTINCT id_usuario) AS usuarios_iniciales\n",
    "    FROM usuarios_cohorte\n",
    "    GROUP BY cohorte\n",
    "),\n",
    "\n",
    "actividad AS (\n",
    "    SELECT DISTINCT\n",
    "        ua.id_usuario,\n",
    "        uc.cohorte,\n",
    "        (\n",
    "            CAST(ua.fecha_actividad AS DATE)\n",
    "            - uc.fecha_registro\n",
    "        ) AS dias_desde_registro\n",
    "    FROM user_activity ua\n",
    "    INNER JOIN usuarios_cohorte uc\n",
    "        ON ua.id_usuario = uc.id_usuario\n",
    "),\n",
    "\n",
    "retencion AS (\n",
    "    SELECT\n",
    "        cohorte,\n",
    "\n",
    "        COUNT(DISTINCT CASE\n",
    "            WHEN dias_desde_registro BETWEEN 7 AND 13\n",
    "            THEN id_usuario\n",
    "        END) AS retencion_w1,\n",
    "\n",
    "        COUNT(DISTINCT CASE\n",
    "            WHEN dias_desde_registro BETWEEN 14 AND 20\n",
    "            THEN id_usuario\n",
    "        END) AS retencion_w2,\n",
    "\n",
    "        COUNT(DISTINCT CASE\n",
    "            WHEN dias_desde_registro BETWEEN 21 AND 27\n",
    "            THEN id_usuario\n",
    "        END) AS retencion_w3\n",
    "\n",
    "    FROM actividad\n",
    "    GROUP BY cohorte\n",
    ")\n",
    "\n",
    "SELECT\n",
    "    ui.cohorte,\n",
    "    ui.usuarios_iniciales,\n",
    "\n",
    "    COALESCE(r.retencion_w1, 0) AS retencion_w1,\n",
    "    COALESCE(r.retencion_w2, 0) AS retencion_w2,\n",
    "    COALESCE(r.retencion_w3, 0) AS retencion_w3,\n",
    "\n",
    "    ROUND(\n",
    "        COALESCE(r.retencion_w1, 0) * 100.0\n",
    "        / NULLIF(ui.usuarios_iniciales, 0),\n",
    "        2\n",
    "    ) AS semana_1,\n",
    "\n",
    "    ROUND(\n",
    "        COALESCE(r.retencion_w2, 0) * 100.0\n",
    "        / NULLIF(ui.usuarios_iniciales, 0),\n",
    "        2\n",
    "    ) AS semana_2,\n",
    "\n",
    "    ROUND(\n",
    "        COALESCE(r.retencion_w3, 0) * 100.0\n",
    "        / NULLIF(ui.usuarios_iniciales, 0),\n",
    "        2\n",
    "    ) AS semana_3\n",
    "\n",
    "FROM usuarios_iniciales ui\n",
    "LEFT JOIN retencion r\n",
    "    ON ui.cohorte = r.cohorte\n",
    "\n",
    "ORDER BY ui.cohorte;\n",
    "'''\n",
    "\n",
    "# Ejecutar la consulta\n",
    "cohorte_final = pd.read_sql(query_cohort_retention_final, con=engine)\n",
    "cohorte_final"
   ]
