   "source": [
    "# tu código aquí\n",
    "# KPIs PRINCIPALES\n",
    "\n",
    "# Copias de trabajo\n",
    "orders_kpi = orders_clean.copy()\n",
    "catalog_kpi = catalog_clean.copy()\n",
    "marketing_kpi = marketing_clean.copy()\n",
    "\n",
    "# Unir pedidos con catálogo para obtener el costo unitario\n",
    "orders_kpi = orders_kpi.merge(\n",
    "    catalog_kpi[[\"nombre_producto\", \"costo_unitario\"]],\n",
    "    on=\"nombre_producto\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "# Calcular costo total por línea/pedido\n",
    "orders_kpi[\"costo_total\"] = (\n",
    "    orders_kpi[\"cantidad\"] *\n",
    "    orders_kpi[\"costo_unitario\"]\n",
    ")"
   ]
  },
