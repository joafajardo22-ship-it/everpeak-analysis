     ]
    }
   ],
   "source": [
    "# Tasa de conversión por variante\n",
    "# ==========================================\n",
    "\n",
    "conversion = experiment.groupby(\"variante\")[\"convirtio\"].agg(\n",
    "    [\"sum\", \"count\", \"mean\"]\n",
    ")\n",
    "\n",
    "conversion[\"tasa_conversion\"] = conversion[\"mean\"] * 100\n",
    "\n",
    "print(conversion)"
   ]
